# ========================================================
# CẤU HÌNH AI DỊCH TRUYỆN (NOVEL TRANSLATOR)
# ========================================================

# Nhà cung cấp AI mặc định: 'gemini', 'deepseek', 'grok', 'openrouter'
AI_PROVIDER=deepseek

# 1. Cấu hình DeepSeek API (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 2. Cấu hình OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=your_opẻnouter_model
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 3. Cấu hình Grok / xAI API (https://api.x.ai/v1)
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-4.6
GROK_BASE_URL=https://api.x.ai/v1

# 4. Cấu hình Google Gemini (Khuyên dùng - https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
